<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>NightTech.Recovery</RootNamespace>
    <AssemblyName>NightTechRecovery</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\NightTechRecovery.ico</ApplicationIcon>
    <Version>0.2.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Company>Night Tech Solutions</Company>
    <Product>Night Tech Recovery</Product>
    <Copyright>Copyright (c) Night Tech Solutions</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NightTech.Core\NightTech.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- WPF projects leave System.IO out of the implicit usings. -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\logo-icon.png" />
  </ItemGroup>

</Project>
