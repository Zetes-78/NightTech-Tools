<Window x:Class="NightTech.FieldKit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Night Tech Field Kit"
        Width="1100" Height="800" MinWidth="880" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Page}"
        Icon="Assets/logo-icon.png">
  <DockPanel>

    <!-- Header -->
    <Border DockPanel.Dock="Top" Background="{StaticResource Navy}" Padding="20,14">
      <DockPanel>
        <Border DockPanel.Dock="Left" Background="White" CornerRadius="8" Padding="4" Margin="0,0,14,0">
          <Image Source="Assets/logo-icon.png" Width="40" Height="40" />
        </Border>
        <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right">
          <TextBlock x:Name="VersionText" Foreground="#A9BFD9" HorizontalAlignment="Right" />
          <TextBlock x:Name="ModeText" Foreground="#A9BFD9" HorizontalAlignment="Right" />
        </StackPanel>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Night Tech Field Kit" Foreground="White" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="Check a computer's health in a few minutes and leave the customer a clear report. Read only: nothing on the computer is changed."
                     Foreground="#DBE7F5" FontSize="13" TextWrapping="Wrap" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Footer log -->
    <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="16,8">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Activity" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="0,0,0,4" />
        <ListBox x:Name="LogList" Height="90" BorderThickness="0" FontFamily="Consolas" FontSize="12" />
      </DockPanel>
    </Border>

    <Grid Margin="20,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="300" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Left: the job and actions -->
      <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Job" Style="{StaticResource SectionTitle}" />
              <TextBlock Text="Ticket number (from Night Tech Hub)" Foreground="{StaticResource Muted}" />
              <TextBox x:Name="TicketBox" Margin="0,2,0,8" MaxLength="20" />
              <TextBlock Text="Customer name" Foreground="{StaticResource Muted}" />
              <TextBox x:Name="CustomerBox" Margin="0,2,0,8" MaxLength="80" />
              <TextBlock Text="Technician" Foreground="{StaticResource Muted}" />
              <TextBox x:Name="TechBox" Margin="0,2,0,12" MaxLength="80" />
              <Button x:Name="RunButton" Content="Run all checks" Style="{StaticResource PrimaryButton}" Click="Run_Click" />
              <ProgressBar x:Name="Busy" Height="6" Margin="0,10,0,0" IsIndeterminate="True" Visibility="Collapsed" />
              <TextBlock x:Name="StatusText" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource Muted}"
                         Text="Takes about a minute. Nothing on this computer is changed." />
            </StackPanel>
          </Border>

          <Border x:Name="AdminCard" Style="{StaticResource Card}" BorderBrush="{StaticResource Orange}" Background="{StaticResource OrangeSoft}">
            <StackPanel>
              <TextBlock Text="Not running as administrator" Style="{StaticResource SectionTitle}" />
              <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                         Text="Most checks work as is. Drive temperature and wear, and BitLocker status, need administrator rights." />
              <Button Content="Restart as administrator" Style="{StaticResource PlainButton}" Click="Elevate_Click" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Report" Style="{StaticResource SectionTitle}" />
              <Button x:Name="OpenReportButton" Content="Open customer report" Style="{StaticResource PlainButton}" Margin="0,0,0,8"
                      IsEnabled="False" Click="OpenReport_Click" />
              <Button Content="Open reports folder" Style="{StaticResource PlainButton}" Margin="0,0,0,8" Click="OpenFolder_Click" />
              <Button x:Name="CopyButton" Content="Copy summary for the ticket" Style="{StaticResource PlainButton}" IsEnabled="False"
                      Click="Copy_Click" />
              <TextBlock x:Name="SavedText" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- Right: results and tools -->
      <TabControl Grid.Column="2" x:Name="Tabs" Background="White" BorderBrush="{StaticResource Line}">
        <TabItem Header="  Findings  ">
          <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
            <StackPanel>
              <TextBlock x:Name="SummaryText" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Navy}" Margin="0,0,0,10"
                         TextWrapping="Wrap" Text="Click &quot;Run all checks&quot; to start." />
              <ItemsControl x:Name="FindingsList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{Binding Accent}" Background="{Binding Soft}" BorderThickness="5,0,0,0" Padding="10,8" Margin="0,0,0,8" CornerRadius="3">
                      <StackPanel>
                        <StackPanel Orientation="Horizontal">
                          <Border Background="{Binding Accent}" CornerRadius="3" Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Tag}" Foreground="White" FontSize="11" FontWeight="Bold" />
                          </Border>
                          <TextBlock Text="{Binding Area}" Foreground="{StaticResource Muted}" Margin="0,0,8,0" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,4,0,0" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="  Full report  ">
          <TextBox x:Name="FullText" IsReadOnly="True" FontFamily="Consolas" FontSize="12" BorderThickness="0"
                   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" Padding="8" />
        </TabItem>

        <TabItem Header="  Tools  ">
          <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
            <StackPanel>
              <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,12"
                         Text="Shortcuts to Windows' own repair and inspection tools, plus Night Tech tools. Ones marked (admin) ask for administrator rights." />
              <WrapPanel x:Name="ToolsPanel" />
            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </TabControl>
    </Grid>
  </DockPanel>
</Window>
